@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ent-party: <https://richd75.github.io/enterprise-ontology/core/party.ttl#> .
@prefix ent-loc:   <https://richd75.github.io/enterprise-ontology/core/location.ttl#> .
@prefix ent-bridge:<https://richd75.github.io/enterprise-ontology/bridges/party-location-bridge.ttl#> .

<https://richd75.github.io/enterprise-ontology/bridges/party-location-bridge.ttl> a owl:Ontology ;
    rdfs:label "Party-Location Bridge Ontology" ;
    owl:imports <https://richd75.github.io/enterprise-ontology/core/party.ttl> ,
                <https://richd75.github.io/enterprise-ontology/core/location.ttl> .

# A Party receives correspondence at A Postal Address
ent-bridge:receivesCorrespondenceAt a owl:ObjectProperty ;
    rdfs:label "receives correspondence at" ;
    rdfs:comment "A Party receives correspondence at A Postal Address" ;
    rdfs:domain ent-party:Party ;
    rdfs:range ent-loc:PostalAddress .

# An Individual resides at A Postal Address
ent-bridge:residesAt a owl:ObjectProperty ;
    rdfs:label "resides at" ;
    rdfs:comment "An Individual resides at A Postal Address" ;
    rdfs:subPropertyOf ent-bridge:receivesCorrespondenceAt ;
    rdfs:domain ent-party:Individual ;
    rdfs:range ent-loc:PostalAddress .

# An Organisation was incorporated in A Country
ent-bridge:wasIncorporatedIn a owl:ObjectProperty ;
    rdfs:label "was incorporated in" ;
    rdfs:comment "An Organisation was incorporated in A Country" ;
    rdfs:domain ent-party:Organisation ;
    rdfs:range ent-loc:Country .